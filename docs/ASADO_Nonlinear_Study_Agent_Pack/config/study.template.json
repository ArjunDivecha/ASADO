      "tuned": false,
      "tie_break": "L_X"
    },
    "A_S": {
      "estimator": "HistGradientBoostingRegressor",
      "representation": "S",
      "max_depth": 1,
      "max_leaf_nodes": 2,
      "tuned": true
    },
    "Q_S": {
      "estimator": "ridge",
      "representation": "quadratic_S",
      "predictor_dimension": 152,
      "tuned": true
